things.bssd.co.uk {
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    handle_path /api/* {
        reverse_proxy things-app-1:8080
    }

    # Vite content-hashes filenames under /assets/*, so the same filename never changes meaning -
    # safe to cache aggressively and forever.
    handle /assets/* {
        root * /srv/things-ui/current
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # index.html (and the SPA-route fallback to it) references those hashed filenames, so it must
    # always be revalidated - otherwise a browser can keep serving a stale index.html pointing at
    # an asset filename from a previous deploy indefinitely.
    handle {
        root * /srv/things-ui/current
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}

hobbs.bssd.co.uk {
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    handle_path /api/* {
        reverse_proxy hobbs-app-1:8080
    }

    # Flutter's default web build doesn't content-hash filenames (unlike Vite), so nothing here is
    # safe to cache aggressively yet - no-cache everywhere until that's confirmed/changed.
    handle {
        root * /srv/hobbs-ui/current
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
